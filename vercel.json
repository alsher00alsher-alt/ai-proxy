{
  "version": 2,
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/dual-camera",
      "destination": "/public/dual-camera.html"
    },
    {
      "source": "/phone-protection",
      "destination": "/public/phone-protection.html"
    },
    {
      "source": "/wifi-checker",
      "destination": "/public/wifi-checker.html"
    },
    {
      "source": "/hack-panel",
      "destination": "/public/hack-panel.html"
    }
  ]
}
