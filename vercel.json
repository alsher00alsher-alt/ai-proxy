{
  "version": 2,
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/free-sms",
      "destination": "/public/free-sms.html"
    },
    {
      "source": "/spam-messages",
      "destination": "/public/spam-messages.html"
    },
    {
      "source": "/number-hack",
      "destination": "/public/number-hack.html"
    },
    {
      "source": "/phone-protection",
      "destination": "/public/phone-protection.html"
    },
    {
      "source": "/wifi-checker",
      "destination": "/public/wifi-checker.html"
    },
    {
      "source": "/hack-panel",
      "destination": "/public/hack-panel.html"
    }
  ]
}
