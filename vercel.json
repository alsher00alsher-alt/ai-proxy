{
  "version": 2,
  "routes": [
    {
      "src": "/camera-protect",
      "dest": "/public/camera-protect.html"
    },
    {
      "src": "/wifi-checker",
      "dest": "/public/wifi-checker.html"
    },
    {
      "src": "/hack-panel",
      "dest": "/public/hack-panel.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
