{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/wifi-checker",
      "dest": "/public/wifi-checker.html"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
